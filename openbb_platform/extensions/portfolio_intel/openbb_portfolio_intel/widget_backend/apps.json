[
  {
    "name": "Portfolio Intelligence — Overview",
    "img": "",
    "img_dark": "",
    "img_light": "",
    "description": "Default portfolio-intel dashboard: X-Ray, What-If, and Brinson attribution.",
    "allowCustomization": true,
    "tabs": {
      "overview": {
        "id": "overview",
        "name": "Overview",
        "layout": [
          {
            "i": "pi_xray_sector",
            "x": 0,
            "y": 0,
            "w": 20,
            "h": 9,
            "state": { "params": { "account_id": "demo" } }
          },
          {
            "i": "pi_whatif_diff",
            "x": 20,
            "y": 0,
            "w": 20,
            "h": 9,
            "state": { "params": { "symbol": "AAPL", "delta_shares": "100" } }
          },
          {
            "i": "pi_brinson_attribution",
            "x": 0,
            "y": 9,
            "w": 40,
            "h": 9,
            "state": { "params": { "window": "1Y", "benchmark_symbol": "SPY" } }
          }
        ]
      }
    },
    "groups": []
  },
  {
    "id": "portfolio-intelligence-terminal",
    "name": "Portfolio Intelligence — Terminal",
    "img": "",
    "img_dark": "",
    "img_light": "",
    "description": "Eleven-tab persona surface: seven research tabs (symbol-scoped) plus four portfolio tabs (book-scoped). Sandbox-style clone extended with X-Ray, Risk, Paper Trading, and Alerts (EPIC #1634). Context bars: research tabs share `symbol`; portfolio tabs share `account_id`.",
    "allowCustomization": true,
    "params": {
      "symbol": "AAPL",
      "account_id": "demo"
    },
    "tabs": {
      "overview": {
        "id": "overview",
        "name": "F1: Overview",
        "layout": [
          { "i": "pi_symbol_context",         "x": 0, "y": 0,  "w": 40, "h": 2,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_profile_header",  "x": 0, "y": 2,  "w": 40, "h": 5,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_key_stats",       "x": 0, "y": 7,  "w": 20, "h": 10, "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_price_history",   "x": 20, "y": 7, "w": 20, "h": 10, "state": { "params": { "symbol": "AAPL", "chart_type": "line" } } }
        ]
      },
      "financials": {
        "id": "financials",
        "name": "F2: Financials",
        "layout": [
          { "i": "pi_symbol_context",          "x": 0, "y": 0, "w": 40, "h": 2,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_financial_charts", "x": 0, "y": 2, "w": 40, "h": 10, "state": { "params": { "symbol": "AAPL" } } }
        ]
      },
      "technicals": {
        "id": "technicals",
        "name": "F3: Technicals",
        "layout": [
          { "i": "pi_symbol_context",        "x": 0, "y": 0, "w": 40, "h": 2,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_technicals",     "x": 0, "y": 2, "w": 20, "h": 12, "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_price_history",  "x": 20, "y": 2, "w": 20, "h": 12, "state": { "params": { "symbol": "AAPL", "chart_type": "candle" } } }
        ]
      },
      "comparison": {
        "id": "comparison",
        "name": "F4: Comparison",
        "layout": [
          { "i": "pi_symbol_context",       "x": 0, "y": 0, "w": 40, "h": 2,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_competitors",   "x": 0, "y": 2, "w": 40, "h": 6,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_complementary", "x": 0, "y": 8, "w": 40, "h": 12, "state": { "params": { "symbol": "AAPL" } } }
        ]
      },
      "ownership": {
        "id": "ownership",
        "name": "F5: Ownership",
        "layout": [
          { "i": "pi_symbol_context",   "x": 0, "y": 0, "w": 40, "h": 2,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_key_stats", "x": 0, "y": 2, "w": 40, "h": 10, "state": { "params": { "symbol": "AAPL" } } }
        ]
      },
      "calendar": {
        "id": "calendar",
        "name": "F6: Calendar",
        "layout": [
          { "i": "pi_symbol_context", "x": 0, "y": 0, "w": 40, "h": 2,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_event_calendar", "x": 0, "y": 2, "w": 40, "h": 12, "state": { "params": { "account_id": "demo", "horizon_days": "30" } } }
        ]
      },
      "estimates": {
        "id": "estimates",
        "name": "F7: Estimates",
        "layout": [
          { "i": "pi_symbol_context",           "x": 0, "y": 0, "w": 40, "h": 2,  "state": { "params": { "symbol": "AAPL" } } },
          { "i": "pi_equity_analyst_forecasts", "x": 0, "y": 2, "w": 40, "h": 12, "state": { "params": { "symbol": "AAPL" } } }
        ]
      },
      "xray": {
        "id": "xray",
        "name": "F8: X-Ray",
        "layout": [
          { "i": "pi_book_context",       "x": 0,  "y": 0,  "w": 40, "h": 2,  "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_xray_sector",        "x": 0,  "y": 2,  "w": 20, "h": 9,  "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_xray_country",       "x": 20, "y": 2,  "w": 20, "h": 9,  "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_concentration_gauge","x": 0,  "y": 11, "w": 12, "h": 6,  "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_lookthrough_top25",  "x": 12, "y": 11, "w": 28, "h": 12, "state": { "params": { "account_id": "demo" } } }
        ]
      },
      "risk": {
        "id": "risk",
        "name": "F9: Risk & Attribution",
        "layout": [
          { "i": "pi_book_context",         "x": 0,  "y": 0,  "w": 40, "h": 2, "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_risk_dashboard",       "x": 0,  "y": 2,  "w": 12, "h": 6, "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_concentration_gauge",  "x": 12, "y": 2,  "w": 8,  "h": 6, "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_risk_vol_chart",       "x": 20, "y": 2,  "w": 20, "h": 8, "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_brinson_attribution",  "x": 0,  "y": 10, "w": 40, "h": 9, "state": { "params": { "window": "1Y", "benchmark_symbol": "SPY" } } }
        ]
      },
      "paper": {
        "id": "paper",
        "name": "F10: Paper Trading",
        "layout": [
          { "i": "pi_book_context",       "x": 0,  "y": 0,  "w": 40, "h": 2,  "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_paper_ticket",       "x": 0,  "y": 2,  "w": 16, "h": 8,  "state": { "params": { "account_id": "demo", "symbol": "AAPL", "side": "buy", "quantity": "100", "confirm": "false" } } },
          { "i": "pi_paper_perf_kpis",    "x": 16, "y": 2,  "w": 12, "h": 6,  "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_paper_performance",  "x": 0,  "y": 10, "w": 32, "h": 10, "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_paper_blotter",      "x": 0,  "y": 20, "w": 32, "h": 10, "state": { "params": { "account_id": "demo" } } }
        ]
      },
      "alerts": {
        "id": "alerts",
        "name": "F11: Alerts & Catalysts",
        "layout": [
          { "i": "pi_book_context",       "x": 0,  "y": 0,  "w": 40, "h": 2,  "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_alerts_panel",       "x": 0,  "y": 2,  "w": 30, "h": 10, "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_smart_money_ribbon", "x": 0,  "y": 12, "w": 40, "h": 8,  "state": { "params": { "account_id": "demo" } } },
          { "i": "pi_news_ribbon",        "x": 0,  "y": 20, "w": 30, "h": 10, "state": { "params": { "account_id": "demo", "horizon_days": "7" } } }
        ]
      }
    },
    "groups": []
  }
]
