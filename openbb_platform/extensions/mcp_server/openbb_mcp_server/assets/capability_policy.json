  "traceability": {
    "work_families": {
      "notebook-story-techtrade": {
        "owner_issues": ["#2316 TechTrade validation-gate and indicator analytics over MCP"],
        "rationale": "Portfolio profiles run the TechTrade notebooks' local calculations server-side through openbb_techtrade.engine.story_analytics: market weather, the local 13F summary, actionable plan review, round-trip P&L, forward-bar replay and indicator-config review; bounded finite inputs, provider failures are errors.",
        "source_evidence": [
          "openbb_platform/extensions/mcp_server/openbb_mcp_server/story_adapters/techtrade_story.py",
          "openbb_platform/extensions/techtrade/openbb_techtrade/engine/story_analytics.py",
          "openbb_platform/extensions/mcp_server/tests/story_adapters/test_techtrade_story.py",
          "openbb_platform/extensions/techtrade/tests/unit/test_story_analytics.py"
        ],
        "review_triggers": ["techtrade story route added", "story analytics math changed", "replay or 13F source changed"],
        "implementation_state": "implemented_product"
      },
      "notebook-story-attribution": {
        "owner_issues": ["#2315 Event timeline, Brinson attribution and recommendation-basket analytics over MCP"],
        "rationale": "Portfolio profiles compute the portfolio/05 chapter server-side: Brinson-Fachler attribution through the trusted oracle, weight-space what-if diffs and the conviction-to-trade rule; pure computation over bounded, finite inputs that never guesses a missing price or renormalizes weights.",
        "source_evidence": [
          "openbb_platform/extensions/mcp_server/openbb_mcp_server/story_adapters/attribution.py",
          "openbb_platform/extensions/portfolio_intel/openbb_portfolio_intel/analytics/trade_preview.py",
          "openbb_platform/extensions/mcp_server/tests/story_adapters/test_attribution.py",
          "openbb_platform/extensions/portfolio_intel/tests/unit/test_trade_preview.py"
        ],
        "review_triggers": ["attribution route added", "what-if math changed", "trade rule changed"],
        "implementation_state": "implemented_product"
      },
      "notebook-story-single-name": {
        "owner_issues": ["#2314 Seven-phase single-name analysis pipeline over MCP"],
        "rationale": "Portfolio profiles run the repository's seven-phase Analysis pipeline for one symbol and receive every phase result, gate diagnostics and provenance as bounded strict JSON; the pipeline is loaded, not copied, and concurrent runs are capped.",
        "source_evidence": [
          "openbb_platform/extensions/mcp_server/openbb_mcp_server/story_adapters/single_name.py",
          "openbb_platform/extensions/mcp_server/tests/story_adapters/test_single_name.py"
        ],
        "review_triggers": ["single-name route changed", "phase result fields changed", "pipeline loading changed"],
        "implementation_state": "implemented_product"
      },
      "notebook-story-analytics": {
        "owner_issues": ["#2313 Basket look-through, sector roll-up and concentration analytics over MCP"],
        "rationale": "Portfolio profiles compute the portfolio/03 x-ray chapter server-side: N-PORT look-through, sector roll-up, concentration and capped construction targets, through the same engine the notebook calls; bounded inputs, no notebook state or file writes.",
        "source_evidence": [
          "openbb_platform/extensions/mcp_server/openbb_mcp_server/story_adapters/analytics.py",
          "openbb_platform/extensions/portfolio_intel/openbb_portfolio_intel/analytics/basket_lookthrough.py",
          "openbb_platform/extensions/mcp_server/tests/story_adapters/test_analytics.py",
          "openbb_platform/extensions/portfolio_intel/tests/unit/test_basket_lookthrough.py",
          "openbb_platform/extensions/portfolio_intel/tests/unit/test_basket_lookthrough_parity.py"
        ],
        "review_triggers": ["story analytics route added", "look-through math changed", "provider lookup changed"],
        "implementation_state": "implemented_product"
      },
      "notebook-story-registry": {
        "owner_issues": ["#2216 Story catalog, run registry and typed state management tools"],
        "rationale": "Portfolio profiles list and describe the 25 reviewed notebook stories and keep principal-scoped, version-checked JSON run state; nothing runs a notebook, reads arbitrary files or unpickles state.",
        "source_evidence": [
          "openbb_platform/extensions/mcp_server/openbb_mcp_server/story_adapters/registry.py",
          "openbb_platform/extensions/mcp_server/tests/story_adapters/test_registry.py"
        ],
        "review_triggers": ["story route added", "run-state schema changed", "principal scoping changed"],
        "implementation_state": "implemented_product"
      },
      "notebook-story-artifacts": {
        "owner_issues": ["#2217 Produce bounded chart, table, report and XLSX artifacts"],
        "rationale": "Portfolio profiles write and read bounded table, chart, report and workbook artifacts inside a run they own; IDs are server-issued, files are created atomically under the store root without links or overwrites, spreadsheet cells cannot hold formulas, and reads re-verify the stored hash.",
        "source_evidence": [
          "openbb_platform/extensions/mcp_server/openbb_mcp_server/story_adapters/artifacts.py",
          "openbb_platform/extensions/mcp_server/tests/story_adapters/test_artifacts.py"
        ],
        "review_triggers": ["artifact route added", "artifact format added", "artifact limits or scoping changed"],
        "implementation_state": "implemented_product"
      },
      "notebook-story-jobs": {
        "owner_issues": ["#2218 Bridge backtest, tuning and replay into existing durable jobs"],
        "rationale": "Portfolio profiles queue five allowlisted story job kinds (single-name analysis, backtest, validation, never-persisted tuning, replay) with typed payloads on the existing durable jobs service; operation IDs make submission idempotent, the worker runs only recorded submissions, results become run artifacts, and each principal has a bounded number of active jobs.",
        "source_evidence": [
          "openbb_platform/extensions/mcp_server/openbb_mcp_server/story_adapters/jobs.py",
          "openbb_platform/extensions/mcp_server/openbb_mcp_server/story_adapters/story_job_kinds.py",
          "openbb_platform/extensions/mcp_server/tests/story_adapters/test_jobs.py"
        ],
        "review_triggers": ["story job kind added", "job payload changed", "job limits or scoping changed"],
        "implementation_state": "implemented_product"
      },
      "notebook-story-paper": {
        "owner_issues": ["#2331 Human approval gate and isolated paper sandboxes (TechTrade engine)", "#2333 Portfolio paper blotter and low-buying-power alert in a durable sandbox"],
        "rationale": "Portfolio profiles create principal-scoped paper sandboxes and prepare typed actions; only portfolio-ops may apply one, and only with an HMAC approval a person grants outside the model over the stored request (principal, sandbox, run, action, argument hash, manifest, expiry, nonce). Applies are consumed once and deduplicated; no broker or live endpoint is reachable.",
