//@version=6
strategy("SMA Crossover", overlay=true, initial_capital=1000000)
fast_len = input.int(10, "Fast SMA")
slow_len = input.int(30, "Slow SMA")
fast = ta.sma(close, fast_len)
slow = ta.sma(close, slow_len)
if ta.crossover(fast, slow)
    strategy.entry("Long", strategy.long)
if ta.crossunder(fast, slow)
    strategy.close("Long")
plot(fast, "Fast", color=color.blue)
plot(slow, "Slow", color=color.orange)
