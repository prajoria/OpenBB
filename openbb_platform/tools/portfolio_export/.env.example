# Copy to `.env` and edit. All paths must resolve OUTSIDE the git repo.

# Where recorded flows save downloaded files.
# Default: ~/portfolio_exports
PORTFOLIO_EXPORT_DIR=~/portfolio_exports

# Persistent Chromium user-data-dir (keeps you logged in across sessions).
# Default: ~/.portfolio_export/chrome_profile
PORTFOLIO_EXPORT_PROFILE_DIR=~/.portfolio_export/chrome_profile

# Where `pe record` scaffolds new recordings and `pe replay` looks first.
# Keep this OUTSIDE the repo so your recorded flows can never be accidentally
# committed. Default: ~/portfolio_export_recordings
PORTFOLIO_EXPORT_RECORDINGS_DIR=~/portfolio_export_recordings

# Run replays headless (1) or windowed (0). Default: 0.
PORTFOLIO_EXPORT_HEADLESS=0
