# Local config — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Playwright artifacts (traces, videos) if any
trace.zip
videos/
screenshots/

# Recordings — user-specific selectors, URLs, and flow logic. Keep private.
# Whitelist the package marker + the example scaffold so the tool still
# ships with a working template.
recordings/*.py
!recordings/__init__.py
!recordings/example_fidelity_export.py
