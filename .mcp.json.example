{
  "mcpServers": {
    "openbb-platform-standard": {
      "type": "http",
      "url": "http://127.0.0.1:8001/mcp"
    },
    "openbb-workspace-integrated": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp"
    },
    "openbb-workspace-standalone-optional": {
      "type": "http",
      "url": "http://127.0.0.1:8787/mcp"
    },
    "openbb-agents": {
      "command": "python",
      "args": ["-m", "openbb_agents.mcp_server"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/openbb_platform/extensions/agents"
      }
    },
    "openbb-daytrade": {
      "command": "openbb-daytrade",
      "args": ["mcp-serve"],
      "cwd": "${workspaceFolder}"
    }
  }
}
