{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".venv_win/Scripts/python.exe .claude/hooks/block-protected-branch-push.py",
            "timeout": 10,
            "statusMessage": "Checking branch-push protection..."
          }
        ]
      }
    ]
  }
}
