// Hand-translated Pine v6 equivalent of typed_function_args.v5.pine.
// Only rewrite: study() → indicator(). The custom-function shape is
// v5+v6 compatible (untyped params are the common form; typed-param
// support is a Phase-3 grammar addition).
//@version=6
indicator("Custom Function Two Args", overlay=true)
length = input.int(14, minval=1)
weighted(src, len) =>
    basis = ta.sma(src, len)
    basis + src / 2
smoothed = weighted(close, length)
plot(smoothed, title="w", color=color.red)
