        "description": "Filter by snapshot date (YYYY-MM-DD). Defaults to latest.",
        "type": "date",
        "value": null,
        "optional": true,
        "show": true
      }
    ],
    "data": {
      "dataKey": "",
      "table": {
        "showAll": true,
        "enableAdvanced": true,
        "columnsDefs": [
          { "field": "symbol", "headerName": "Symbol", "cellDataType": "text", "pinned": "left", "renderFn": "cellOnClick", "renderFnParams": { "actionType": "groupBy", "groupByParamName": "symbol" } },
          { "field": "description", "headerName": "Description", "cellDataType": "text" },
          { "field": "account_name", "headerName": "Account", "cellDataType": "text" },
          { "field": "owner", "headerName": "Owner", "cellDataType": "text" },
          { "field": "quantity", "headerName": "Qty", "cellDataType": "number", "formatterFn": "none" },
          { "field": "avg_cost_basis", "headerName": "Avg Cost", "cellDataType": "number", "formatterFn": "none" },
          { "field": "cost_basis_total", "headerName": "Cost Basis", "cellDataType": "number", "formatterFn": "none" },
          { "field": "current_value", "headerName": "Current Value", "cellDataType": "number", "formatterFn": "none" },
          { "field": "total_gain_loss", "headerName": "Gain/Loss", "cellDataType": "number", "formatterFn": "none", "renderFn": "greenRed" },
          { "field": "pct_gain_loss", "headerName": "Return %", "cellDataType": "number", "formatterFn": "percent", "renderFn": "greenRed" },
          { "field": "term", "headerName": "Term", "cellDataType": "text" },
          { "field": "acquired", "headerName": "Acquired", "cellDataType": "date", "formatterFn": "none" },
          { "field": "share_source", "headerName": "Source", "cellDataType": "text" },
          { "field": "snapshot_date", "headerName": "Snapshot", "cellDataType": "date", "formatterFn": "none" }
        ]
      }
    },
    "source": ["Portfolio App"]
  },

