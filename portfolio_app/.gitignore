# Python
__pycache__/
*.pyc
*.pyo

# SSL certs (generated per-machine)
cert.pem
key.pem

# Generated test fixtures (regenerate via: python -m tests.mock_data_generator)
tests/fixtures/*.json

# Local analysis notebooks — these tend to retain machine-specific absolute
# paths and executed output cells with personal portfolio data. Keep them
# out of the shared branch; parameterize + strip outputs before committing.
analysis/*.ipynb

# Runtime logs
logs/
*.log

# IDE
.idea/
.vscode/
*.swp
