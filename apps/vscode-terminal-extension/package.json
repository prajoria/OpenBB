{
  "name": "openbb-terminal-vscode",
  "displayName": "OpenBB Terminal",
  "description": "OpenBB Trading Terminal inside VS Code — layouts, widgets, and a local API bridge.",
  "publisher": "prajoria",
  "version": "0.0.28",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Data Science",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:openbb.openTerminal",
    "onCommand:openbb.startBackend",
    "onCommand:openbb.stopBackend",
    "onCommand:openbb.restartBackend",
    "onCommand:openbb.openBackendLogs",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openbb.openTerminal",
        "title": "OpenBB: Open Terminal"
      },
      {
        "command": "openbb.newLayout",
        "title": "OpenBB: New Layout"
      },
      {
        "command": "openbb.openSymbolInTerminal",
        "title": "OpenBB: Open Symbol in Terminal"
      },
      {
        "command": "openbb.openPortfolio",
        "title": "OpenBB: Open Portfolio Overview"
      },
      {
        "command": "openbb.openTradingDesk",
        "title": "OpenBB: Open Trading Desk"
      },
      {
        "command": "openbb.openRisk",
        "title": "OpenBB: Open Portfolio Risk"
      },
      {
        "command": "openbb.openChart",
        "title": "OpenBB: Open Chart"
      },
      {
        "command": "openbb.setApiKey",
        "title": "OpenBB: Set API Key"
      },
      {
        "command": "openbb.previewWidget",
        "title": "OpenBB: Preview Widget"
      },
      {
        "command": "openbb.paperBuyActive",
        "title": "OpenBB: Paper Buy (Active Symbol)"
      },
      {
        "command": "openbb.paperSellActive",
        "title": "OpenBB: Paper Sell (Active Symbol)"
      },
      {
        "command": "openbb.runAnalysis",
        "title": "OpenBB: Run Analysis"
      },
      {
        "command": "openbb.exportLayout",
        "title": "OpenBB: Export Layout"
      },
      {
        "command": "openbb.importLayout",
        "title": "OpenBB: Import Layout"
      },
      {
        "command": "openbb.startBackend",
        "title": "OpenBB: Start Back-end"
      },
      {
        "command": "openbb.stopBackend",
        "title": "OpenBB: Stop Back-end"
      },
      {
        "command": "openbb.restartBackend",
        "title": "OpenBB: Restart Back-end"
      },
      {
        "command": "openbb.openBackendLogs",
        "title": "OpenBB: Open Back-end Logs"
      },
      {
        "command": "openbb.loadGoldenLayout",
        "title": "OpenBB: Load Golden Layout"
      },
      {
        "command": "openbb.resetToDefaultLayouts",
        "title": "OpenBB: Reset to Default Layouts"
      },
      {
        "command": "openbb.previewWidgetFromBrowser",
        "title": "OpenBB: Preview Widget",
        "icon": "$(eye)"
      },
      {
        "command": "openbb.addWidgetToActiveLayout",
        "title": "OpenBB: Add Widget to Active Layout",
        "icon": "$(add)"
      },
      {
        "command": "openbb.showPerfReport",
        "title": "OpenBB: Show Performance Report"
      }
    ],
    "keybindings": [
      {
        "command": "openbb.openTerminal",
        "key": "ctrl+shift+O",
        "mac": "cmd+shift+O"
      },
      {
        "command": "openbb.openPortfolio",
        "key": "ctrl+shift+Q",
        "mac": "cmd+shift+Q"
      },
      {
        "command": "openbb.openTradingDesk",
        "key": "ctrl+shift+T",
        "mac": "cmd+shift+T"
      },
      {
        "command": "openbb.openRisk",
        "key": "ctrl+shift+R",
        "mac": "cmd+shift+R"
      },
      {
        "command": "openbb.paperBuyActive",
        "key": "ctrl+alt+B",
        "mac": "cmd+alt+B",
        "when": "openbb.terminalFocused"
      },
      {
        "command": "openbb.paperSellActive",
        "key": "ctrl+alt+S",
        "mac": "cmd+alt+S",
        "when": "openbb.terminalFocused"
      },
      {
        "command": "openbb.openChart",
        "key": "f9",
        "mac": "f9",
        "when": "editorTextFocus && resourceLangId == python"
      }
    ],
    "configuration": {
      "title": "OpenBB Terminal",
      "properties": {
        "openbb.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Python interpreter that has openbb-api installed. Leave blank to use `python` from PATH. The extension resolves `openbb-api` from the interpreter's Scripts/ (Windows) or bin/ (POSIX) directory."
        },
        "openbb.apiPort": {
          "type": "number",
          "default": 6900,
          "description": "Local port for the openbb-api back-end. Must match `openbb.apiBaseUrl`."
        },
        "openbb.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:6900",
          "description": "Base URL used by the readiness probe and health poller. Loopback only â€” never a public host."
        },
        "openbb.autoStartBackend": {
          "type": "boolean",
          "default": false,
          "description": "If true, spawn (or attach to) the back-end on VS Code startup. Off by default so opening the workspace does not launch a Python process unexpectedly."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openbb-explorer",
          "title": "OpenBB Terminal",
          "icon": "assets/openbb-icon.svg"
        }
      ]
    },
    "views": {
      "openbb-explorer": [
        {
          "id": "openbbLayouts",
          "name": "Layouts"
        },
        {
          "id": "openbbWidgets",
          "name": "Widget Browser"
        },
        {
          "id": "openbbBackend",
          "name": "Back-end Status"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "openbb.previewWidgetFromBrowser",
          "when": "view == openbbWidgets && viewItem == openbbWidget",
          "group": "inline"
        },
        {
          "command": "openbb.addWidgetToActiveLayout",
          "when": "view == openbbWidgets && viewItem == openbbWidget",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "node --test src/webview/panel.test.js src/webview/csp.test.js src/backend/state.test.js src/symbol/validator.test.js src/commands/register.test.js src/layouts/all-layouts.test.js src/data/mode.test.js src/data/fetcher.test.js src/editor/codeAction.test.js src/analysis/runner.test.js src/notebook/watcher.test.js src/hover/regex.test.js src/hover/sparkline.test.js src/golden/loader.test.js src/preview/panel.test.js src/widget-browser/browser.test.js src/paper/handler.test.js src/theme/tokens.test-extended.js src/theme/audit.test.js src/perf/budget.test.js src/perf/harness.test.js",
    "verify:invariants": "bash scripts/verify-auth-invariants.sh",
    "perf:check": "bash scripts/perf-check.sh",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0",
    "@vscode/test-electron": "^2.3.9"
  }
}
