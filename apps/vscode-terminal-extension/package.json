{
  "name": "openbb-terminal-vscode",
  "displayName": "OpenBB Terminal",
  "description": "OpenBB Trading Terminal inside VS Code â€” layouts, widgets, and a local API bridge.",
  "publisher": "prajoria",
  "version": "0.0.8",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Data Science",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:openbb.openTerminal",
    "onCommand:openbb.startBackend",
    "onCommand:openbb.stopBackend",
    "onCommand:openbb.restartBackend",
    "onCommand:openbb.openBackendLogs",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openbb.openTerminal",
        "title": "OpenBB: Open Terminal"
      },
      {
        "command": "openbb.startBackend",
        "title": "OpenBB: Start Back-end"
      },
      {
        "command": "openbb.stopBackend",
        "title": "OpenBB: Stop Back-end"
      },
      {
        "command": "openbb.restartBackend",
        "title": "OpenBB: Restart Back-end"
      },
      {
        "command": "openbb.openBackendLogs",
        "title": "OpenBB: Open Back-end Logs"
      }
    ],
    "configuration": {
      "title": "OpenBB Terminal",
      "properties": {
        "openbb.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Python interpreter that has openbb-api installed. Leave blank to use `python` from PATH. The extension resolves `openbb-api` from the interpreter's Scripts/ (Windows) or bin/ (POSIX) directory."
        },
        "openbb.apiPort": {
          "type": "number",
          "default": 6900,
          "description": "Local port for the openbb-api back-end. Must match `openbb.apiBaseUrl`."
        },
        "openbb.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:6900",
          "description": "Base URL used by the readiness probe and health poller. Loopback only â€” never a public host."
        },
        "openbb.autoStartBackend": {
          "type": "boolean",
          "default": false,
          "description": "If true, spawn (or attach to) the back-end on VS Code startup. Off by default so opening the workspace does not launch a Python process unexpectedly."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openbb-explorer",
          "title": "OpenBB Terminal",
          "icon": "assets/openbb-icon.svg"
        }
      ]
    },
    "views": {
      "openbb-explorer": [
        {
          "id": "openbbLayouts",
          "name": "Layouts"
        },
        {
          "id": "openbbWidgets",
          "name": "Widget Browser"
        },
        {
          "id": "openbbBackend",
          "name": "Back-end Status"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "node --test src/webview/panel.test.js src/webview/csp.test.js src/backend/state.test.js src/symbol/validator.test.js",
    "verify:invariants": "bash scripts/verify-auth-invariants.sh",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0",
    "@vscode/test-electron": "^2.3.9"
  }
}
