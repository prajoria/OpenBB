# docker/e2e/Dockerfile.runner
#
# Thin image for stages that don't need the full OpenBB toolchain:
#   - api_smoke: httpx probes against the api service
#   - reporter:  parse junit XML + write local bug files (NO tracker calls)
#
# Kept small (~150 MB) so it rebuilds fast when scripts change.
# `gh` CLI is intentionally NOT installed — the two-phase rule
# (see ~/.claude/CLAUDE.md) forbids the harness from filing directly.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install httpx==0.27.* junitparser==3.*

COPY docker/e2e/scripts/ /scripts/
RUN chmod +x /scripts/*.sh

WORKDIR /workspace

CMD ["/bin/bash"]
