# docker/e2e/env/stack.env.example
#
# Copy to ../.env (repo-root) or export in your shell before running
# ./run.sh. NONE of these are secrets. Real secrets live in
# ~/.openbb_platform/user_settings.json (bind-mounted at runtime) and
# in the repo-root .env (also bind-mounted read-only).

# Which remote/branch the `checkout` service clones.
DEVELOP_REMOTE=https://github.com/prajoria/OpenBB.git
DEVELOP_BRANCH=develop

# Which GitHub repo the reporter files issues into.
GH_REPO=prajoria/OpenBB

# Symbols for the Analysis stage (comma-separated).
ANALYSIS_SYMBOLS=MSFT,AAPL

# Uncomment to skip the desktop build during local iteration.
# SKIP_DESKTOP=1
