#!/usr/bin/env python
"""ci/local-ci — POSIX entrypoint shim.

Runs `python -m local_ci` with argv passthrough. Works on any host where
python3 is on PATH; on Windows use ci/local-ci.ps1.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

_here = Path(__file__).resolve().parent
sys.path.insert(0, str(_here))

from local_ci.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
