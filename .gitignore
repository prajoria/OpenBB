# Beads / Dolt: rules now live in .beads/.gitignore (tracks config + hooks,
# ignores embeddeddolt/ runtime and the credential key). Issue data syncs via
# `refs/dolt/data` on the git remote; see .beads/README.md.

# Temporary scratch files (ignore contents, not the directory itself, so exceptions below work)
temp/*
# Exceptions: pine-extension PRD + research artifacts are tracked on openbb_tradingview
!temp/openbb-pine-extension-prd.md
!temp/TradingView/
!temp/_crawl_tv.py
!temp/tv_indicators_full.json

# Local data — single backup unit, never committed (see branch-decomposition plan)
# Anchored to repo root so it does NOT swallow source packages named "data"
# (e.g. openbb_backtest/data/ — trading calendars + bundle ingest).
/data/

# MCP client config — machine-specific, use .mcp.json.example as template
.mcp.json

# Analysis exports and generated artifacts (contain portfolio/position data)
Analysis/exports/
Analysis/Fortress*.csv
Analysis/Fortress*.xlsx
Analysis/fortress_*.csv
Analysis/full_research_proposal_weights.csv
Analysis/proposal_comparison_all_positions.csv
Analysis/FortressFinal*.csv
Analysis/financial_data.xlsx

